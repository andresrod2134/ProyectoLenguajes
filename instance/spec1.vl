defmodule Set
  using List

  defspace SuperSet end
  defspace Set < SuperSet end
  defspace Element end

  defoperator union : Set -> Set -> Set [id : ∅] end

  defoperator isIn : Element -> Set -> Bool end

  defoperator implication : Bool -> Bool -> Bool end
  defoperator negation : Bool -> Bool end

  defvar p: Bool, q: Bool end

  defrule (implication p q) -> (negation p) end

  defexpression (forall x in Element . (forall S in Set . (forall U in Set . (x isIn (S union U) ≡ (x isIn S or x in U))))) end

  defoperator bad : Undefined -> Set -> Bool end

end